{
  "info": {
    "name": "Library Book Management API",
    "description": "Collection for testing the Library Book Management REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Add a Book (Valid)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"The Pragmatic Programmer\",\n  \"author\": \"David Thomas, Andrew Hunt\",\n  \"price\": 499,\n  \"category\": \"Computer Science\",\n  \"isAvailable\": true\n}"
        },
        "url": {
          "raw": "http://localhost:3000/books",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books"]
        }
      }
    },
    {
      "name": "2. Add a Book (Validation Error - Price < 1)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Invalid Book\",\n  \"author\": \"John Doe\",\n  \"price\": 0\n}"
        },
        "url": {
          "raw": "http://localhost:3000/books",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books"]
        }
      }
    },
    {
      "name": "3. Get All Books",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books"]
        }
      }
    },
    {
      "name": "4. Get Book by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "<REPLACE_WITH_BOOK_ID>"
            }
          ]
        }
      }
    },
    {
      "name": "5. Update Book by ID",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 550,\n  \"isAvailable\": false\n}"
        },
        "url": {
          "raw": "http://localhost:3000/books/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "<REPLACE_WITH_BOOK_ID>"
            }
          ]
        }
      }
    },
    {
      "name": "6. Delete Book by ID",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "<REPLACE_WITH_BOOK_ID>"
            }
          ]
        }
      }
    }
  ]
}
